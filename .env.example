# Copy this file to .env, then supply your own API key and model.
# Project configuration variables use the OCTOPUS_* prefix.
OCTOPUS_LLM_PROVIDER=openai
OCTOPUS_LLM_MODEL=YOUR_MODEL_NAME
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# To use the Gemini-compatible endpoint, set the provider to gemini,
# select an available model, and supply GEMINI_API_KEY.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
